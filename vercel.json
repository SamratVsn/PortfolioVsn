{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.emailjs.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), magnetometer=(), gyroscope=(), accelerometer=()"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/projects", "destination": "/projects.html" },
    { "source": "/projects/todo", "destination": "/projects/todo.html" },
    { "source": "/projects/themovie", "destination": "/projects/themovie.html" },
    { "source": "/projects/juicetracker", "destination": "/projects/juicetracker.html" },
    { "source": "/projects/kathmandu", "destination": "/projects/kathmandu.html" },
    { "source": "/projects/sms", "destination": "/projects/sms.html" },
    { "source": "/projects/bmsk", "destination": "/projects/bmsk.html" },
    { "source": "/projects/blogvsn", "destination": "/projects/blogvsn.html" },
    { "source": "/projects/this", "destination": "/projects/this.html" },
    { "source": "/privacy", "destination": "/privacy.html" }
  ]
}
