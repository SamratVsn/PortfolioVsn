{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.emailjs.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), magnetometer=(), gyroscope=(), accelerometer=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/projects.html", "destination": "/projects", "permanent": true },
    { "source": "/privacy.html", "destination": "/privacy", "permanent": true },
    { "source": "/projects/avalokan.html", "destination": "/projects/avalokan", "permanent": true },
    { "source": "/projects/todo.html", "destination": "/projects/todo", "permanent": true },
    { "source": "/projects/themovie.html", "destination": "/projects/themovie", "permanent": true },
    { "source": "/projects/juicetracker.html", "destination": "/projects/juicetracker", "permanent": true },
    { "source": "/projects/kathmandu.html", "destination": "/projects/kathmandu", "permanent": true },
    { "source": "/projects/sms.html", "destination": "/projects/sms", "permanent": true },
    { "source": "/projects/bmsk.html", "destination": "/projects/bmsk", "permanent": true },
    { "source": "/projects/blogvsn.html", "destination": "/projects/blogvsn", "permanent": true },
    { "source": "/projects/this.html", "destination": "/projects/this", "permanent": true },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "samratparajuli0.com.np" }],
      "destination": "https://www.samratparajuli0.com.np/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/projects", "destination": "/projects.html" },
    { "source": "/projects/avalokan", "destination": "/projects/avalokan.html" },
    { "source": "/projects/todo", "destination": "/projects/todo.html" },
    { "source": "/projects/themovie", "destination": "/projects/themovie.html" },
    { "source": "/projects/juicetracker", "destination": "/projects/juicetracker.html" },
    { "source": "/projects/kathmandu", "destination": "/projects/kathmandu.html" },
    { "source": "/projects/sms", "destination": "/projects/sms.html" },
    { "source": "/projects/bmsk", "destination": "/projects/bmsk.html" },
    { "source": "/projects/blogvsn", "destination": "/projects/blogvsn.html" },
    { "source": "/projects/this", "destination": "/projects/this.html" },
    { "source": "/privacy", "destination": "/privacy.html" }
  ]
}
