{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-dist.mjs 4180",
      "startServerReadyPattern": "Static dist server",
      "url": [
        "http://127.0.0.1:4180/",
        "http://127.0.0.1:4180/projects",
        "http://127.0.0.1:4180/projects/avalokan"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
