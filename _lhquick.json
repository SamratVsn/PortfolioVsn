{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-dist.mjs 4181",
      "startServerReadyPattern": "Static dist server",
      "url": [
        "http://127.0.0.1:4181/projects"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lhquick"
    }
  }
}